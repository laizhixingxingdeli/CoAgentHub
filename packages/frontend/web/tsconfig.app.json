{
  "extends": "@laizhixingxingdeli/tsconfig/react-library.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2020", "ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["@testing-library/jest-dom", "vitest/globals", "vite/client"]
  },
  "references": [
    {
      "path": "../../backend/server/tsconfig.json"
    },
    {
      "path": "../../backend/database/tsconfig.json"
    }
  ],
  "include": ["src"]
}
