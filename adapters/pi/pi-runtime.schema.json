{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coagent-pi-runtime",
  "title": "CoAgent Pi runtime declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codebuddy": { "$ref": "#/$defs/packageRef" },
        "qoder": { "$ref": "#/$defs/packageRef" },
        "antigravity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageDir", "providerId"],
          "properties": {
            "packageDir": { "type": "string", "minLength": 1 },
            "providerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultModel", "fallbackModel"],
      "properties": {
        "defaultModel": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/[^\\s/]+$" },
        "fallbackModel": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/[^\\s/]+$" }
      }
    }
  },
  "$defs": {
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageDir"],
      "properties": {
        "packageDir": { "type": "string", "minLength": 1 }
      }
    }
  }
}
