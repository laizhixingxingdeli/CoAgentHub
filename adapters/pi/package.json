{
  "name": "coagent-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoAgentHub 的 pi 适配层：把 pi（@earendil-works/pi-coding-agent）变成受控的 L2/L1 agent。平台不 import 任何 agent SDK，适配层通过 stdin/stdout 协议接入。",
  "scripts": {
    "run": "tsx src/cli.ts",
    "test": "node --import tsx --test src/*.spec.ts",
    "models": "tsx src/cli.ts models",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typebox": "^1.3.7",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  }
}
