{
  "name": "coagenthub",
  "version": "4.0.0",
  "description": "🌊 CoAgentHub - An open-source/self-hosted/local-first AI platform: a LAN-scale multi-agent coordination hub.",
  "keywords": [
    "ai",
    "chat",
    "agent",
    "chatbot",
    "local-first",
    "self-hosted",
    "open-source",
    "enterprise-solutions"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "author": "Daniel Jobin <89030717+laizhixingxingdeli@users.noreply.github.com> (https://github.com/laizhixingxingdeli)",
  "scripts": {
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter @laizhixingxingdeli/web",
    "dev": "turbo run dev --parallel",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretest": "pnpm --filter @laizhixingxingdeli/database build && pnpm --filter @laizhixingxingdeli/error build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
