    "@types/pg": "^8.11.11",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/uuid": "^10.0.0",
    "bunchee": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.6",
    "pg": "^8.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.1.2"
  }
}
